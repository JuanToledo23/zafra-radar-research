# Copy to .env (git-ignored) to override. Local development values only, no real secrets.
POSTGRES_DB=zafra
POSTGRES_USER=zafra
# local-only password for the demo database; not a secret, never use it outside localhost
POSTGRES_PASSWORD=zafra_local_only

# Host ports (5432/5433 are often taken by a local Postgres, 8000 by another API,
# 5173 by another Vite app)
DB_PORT=5434
API_PORT=8010
WEB_PORT=5174
