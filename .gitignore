# Secrets
.env

# Data and outputs (keep folder skeleton)
data/**
!data/*/
!data/*/.gitkeep
# Small, reviewed vector/label files are versioned (everything else under data/ is not)
!data/fields/*.geojson
!data/labels/*.csv
outputs/*
!outputs/.gitkeep
*.h5
*.tif

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Per-field figures are regenerated by the scripts; selected ones are copied to docs/figures/
results/**/figures/
