# Secrets
.env

# Data and outputs (keep folder skeleton)
data/**
!data/*/
!data/*/.gitkeep
# Small, reviewed vector/label files are versioned (everything else under data/ is not)
!data/fields/*.geojson
!data/fields/LICENSE
!data/labels/*.csv
# Exercise 9: the web tile index is versioned; the tiles and COGs it lists are not
!data/tiles/*/
!data/tiles/*/tiles_index.json
outputs/*
!outputs/.gitkeep
*.h5
*.tif

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Local tool settings
.claude/

# Per-field figures are regenerated by the scripts; selected ones are copied to docs/figures/
results/**/figures/

# Exercise 4d: SAM checkpoint, Sentinel-2 / WorldCover rasters, SAM masks, per-scene caches
# (all already under data/** or outputs/*; listed so the intent is explicit)
*.pth
data/models/
data/s2/
outputs/segments_ts/
# Area-wide segment files over 10 MB (regenerate with scripts/13_field_segmentation.py)
data/fields/segments.geojson
data/fields/segments_classic.geojson
