# Copy to .env and fill in. Never commit .env.
# NASA Earthdata Login (https://urs.earthdata.nasa.gov) - used for NISAR downloads via ASF
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# Google Earth Engine Cloud project ID (your own Google Cloud project)
EE_PROJECT=
# Anthropic API key (optional, exercise 6 LLM field summaries; without it the template is used)
ANTHROPIC_API_KEY=
